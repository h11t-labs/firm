{#def view #}
{# A post-action notice bar. Its tone (ok/warn) is decided in render.py and the message comes from a
   fixed token plus an integer count, never from request input. The dismiss link reloads the page
   without the notice params (no JS needed); role=status gets it announced to assistive tech. #}
<div class="notice {{ view.tone }}" role="status"><span class="notice-msg">{{ view.message }}</span><a class="notice-x" href="{{ view.dismiss }}" aria-label="Dismiss notice">{{ icons.x }}</a></div>
